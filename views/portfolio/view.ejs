<% layout('layout') %>

<div class="container mt-5">
  <div class="card shadow-lg p-4">
    <div class="text-center">
      <% if (portfolio.imageUrl) { %>
        <img src="<%= portfolio.imageUrl %>" alt="Profile Picture" class="rounded-circle mb-3" width="150" height="150">
      <% } %>
      <h2><%= portfolio.fullName %></h2>
      <p class="text-muted"><%= portfolio.bio %></p>
    </div>

    <hr>

    <h4>Skills</h4>
    <ul>
      <% portfolio.skills.forEach(skill => { %>
        <li><%= skill %></li>
      <% }) %>
    </ul>

    <h4>Education</h4>
    <ul>
      <% portfolio.education.forEach(edu => { %>
        <li><strong><%= edu.degree %></strong>, <%= edu.institution %> (<%= edu.year %>)</li>
      <% }) %>
    </ul>

    <% if (portfolio.experience && portfolio.experience.length) { %>
      <h4>Experience</h4>
      <ul>
        <% portfolio.experience.forEach(exp => { %>
          <li>
            <strong><%= exp.role %></strong> - <%= exp.company %> (<%= exp.duration %>)
            <p><%= exp.description %></p>
          </li>
        <% }) %>
      </ul>
    <% } %>

    <% if (portfolio.projects && portfolio.projects.length) { %>
      <h4>Projects</h4>
      <ul>
        <% portfolio.projects.forEach(proj => { %>
          <li>
            <strong><%= proj.title %></strong> - <%= proj.description %>
            <% if (proj.link) { %>
              (<a href="<%= proj.link %>" target="_blank">View</a>)
            <% } %>
          </li>
        <% }) %>
      </ul>
    <% } %>

    <h4>Social Links</h4>
    <p>
      <a href="<%= portfolio.socialLinks.linkedin %>" target="_blank">LinkedIn</a> |
      <a href="<%= portfolio.socialLinks.github %>" target="_blank">GitHub</a>
    </p>
  </div>
</div>
